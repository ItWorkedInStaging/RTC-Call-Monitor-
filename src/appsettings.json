{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Warning",
      "RtcCallMonitor": "Information"
    }
  },
  "Detection": {
    "LocalNetworks": [],
    "Interfaces": [],
    "CaptureIPv6": true,
    "IgnoreUdpPorts": [ 443 ],
    "CheckIntervalMs": 1000,
    "MinPacketRate": 1,
    "CallStartIntervals": 2,
    "CallEndIntervals": 3
  },
  "Providers": {
    "Directory": "providers",
    "AutoUpdate": {
      "Enabled": true,
      "IntervalHours": 24
    }
  },
  "Webhook": {
    "Enabled": false,
    "CallStartUrl": "",
    "CallEndUrl": "",
    "Headers": {}
  },
  "Mqtt": {
    "Enabled": false,
    "Host": "",
    "Port": 1883,
    "Username": "",
    "Password": "",
    "UseTls": false,
    "AllowUntrustedCertificates": false,
    "DeviceName": "",
    "BaseTopic": "rtc-call-monitor",
    "DiscoveryPrefix": "homeassistant"
  }
}
